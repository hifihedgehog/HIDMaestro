<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-$(HMTargetArchitecture)</RuntimeIdentifier>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HIDMaestro.ProfileCheck</RootNamespace>
    <AssemblyName>HIDMaestroProfileCheck</AssemblyName>
    <!-- No admin required: it reads profile files and runs their programs
         in its own process, with no device. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
</Project>
