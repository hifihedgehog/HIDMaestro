<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>XusbPersonaCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Another running program that holds HIDMaestro state. -->
    <Compile Include="..\probe_common\SdkConsumers.cs" Link="SdkConsumers.cs" />
    <!-- The HID class's own reads of a collection, as backend_parity_check
         makes them. -->
    <Compile Include="..\backend_parity_check\Hid.cs" Link="Hid.cs" />
    <!-- A user's own profile that authors a device with no HID interface. -->
    <EmbeddedResource Include="authored-xusb.json" LogicalName="authored-xusb.json" />
  </ItemGroup>
</Project>
