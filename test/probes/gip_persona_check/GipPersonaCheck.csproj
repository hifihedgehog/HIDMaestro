<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GipPersonaCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Another running program with HIDMaestro.Core.dll loaded. -->
    <Compile Include="..\probe_common\SdkConsumers.cs" Link="SdkConsumers.cs" />
    <!-- Windows.Gaming.Input objects stay referenced until the probe exits. -->
    <Compile Include="..\probe_common\WgiPins.cs" Link="WgiPins.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The live part's variant without the security opt-out. -->
    <None Include="profiles\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="metadata-pins.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
