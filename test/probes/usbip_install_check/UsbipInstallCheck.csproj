<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>UsbipInstallCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
    <None Include="ForeignUsbipPackage.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- R01's other release: usbip-win2 0.9.8.0's host controller files,
       fetched, unpacked and checked against ForeignUsbipPackage.json the way
       the SDK's build handles the pinned release, into foreign-usbip\<arch>
       beside the probe. The installer is cached in build\downloads. Only
       the probe uses them. The SDK never embeds them. Both architectures:
       this output is staged to other machines as built, and the probe takes
       the package for the architecture of the machine it runs on. -->
  <ItemGroup>
    <_HMForeignUsbipInput Include="$(MSBuildProjectDirectory)\ForeignUsbipPackage.json;$(MSBuildProjectDirectory)\..\..\..\scripts\prepare_usbip.ps1" />
    <_HMForeignUsbipOutput Include="$(OutDir)foreign-usbip\x64\usbip2_ude.inf;$(OutDir)foreign-usbip\x64\usbip2_ude.sys;$(OutDir)foreign-usbip\x64\usbip2_ude.cat;$(OutDir)foreign-usbip\arm64\usbip2_ude.inf;$(OutDir)foreign-usbip\arm64\usbip2_ude.sys;$(OutDir)foreign-usbip\arm64\usbip2_ude.cat" />
  </ItemGroup>
  <Target Name="PrepareForeignUsbip" AfterTargets="Build" Condition="'$(HMSandboxPublish)' != 'true'"
          Inputs="@(_HMForeignUsbipInput)" Outputs="@(_HMForeignUsbipOutput)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\scripts\prepare_usbip.ps1&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\ForeignUsbipPackage.json&quot; -FetchInstallers -InstallerDirectory &quot;$(MSBuildProjectDirectory)\..\..\..\build\downloads&quot; -CacheDirectory &quot;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)foreign-usbip&quot; -DestinationDirectory &quot;$(OutDir)foreign-usbip&quot; -Architectures x64,arm64" />
    <!-- The unpacked files keep the installer's timestamps, and a run that
         finds them already in place writes nothing, so the outputs are
         stamped here for the next build's up-to-date check. -->
    <Touch Files="@(_HMForeignUsbipOutput)" />
  </Target>

  <!-- Windows Sandbox has no .NET runtime, so the copy that runs inside it
       is published self-contained into sandbox\ beside the probe, and so
       are S45's and S65's probes, which scenario E runs inside it, into
       sandbox-e2e\ and sandbox-switch2\. The nested publish passes
       HMSandboxPublish so it does not publish again. -->
  <Target Name="PublishForSandbox" AfterTargets="Build" Condition="'$(HMSandboxPublish)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:HMSandboxPublish=true -o &quot;$(OutDir)sandbox&quot; --nologo -v:quiet" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\usbip_e2e_check\UsbipE2ECheck.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:HMSandboxPublish=true -o &quot;$(OutDir)sandbox-e2e&quot; --nologo -v:quiet" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\switch2_composite_check\Switch2CompositeCheck.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:HMSandboxPublish=true -o &quot;$(OutDir)sandbox-switch2&quot; --nologo -v:quiet" />
  </Target>
</Project>
