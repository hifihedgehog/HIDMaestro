<Project Sdk="Microsoft.NET.Sdk">
  <!-- bluetooth_hid_check: a Bluetooth pad that reaches XInput through
       xinputhid, presented on the USB/IP backend as the HID device it is
       over the air (bluetoothHid), with xinputhid on the device's transport
       node. offline: each profile's form, where its buttons and axes land
       against SDL's and xpadneo's parsers, the load rules. live [ids]: the
       device tree Windows builds, XInput control by control, the identity
       XInput and Windows.Gaming.Input report, the rumble packet. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BluetoothHidCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Another running program that holds HIDMaestro state. -->
    <Compile Include="..\probe_common\SdkConsumers.cs" Link="SdkConsumers.cs" />
    <!-- Windows.Gaming.Input objects stay referenced until the probe exits. -->
    <Compile Include="..\probe_common\WgiPins.cs" Link="WgiPins.cs" />
  </ItemGroup>
</Project>
