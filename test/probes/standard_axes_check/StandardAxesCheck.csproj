<Project Sdk="Microsoft.NET.Sdk">
  <!-- standard_axes_check: HMGamepadStateHelpers.StandardAxes keeps every
       stick's axes for a profile whose layout declares no triggers.
       Offline over the catalog, live through the HID report and SDL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>StandardAxesCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
</Project>
