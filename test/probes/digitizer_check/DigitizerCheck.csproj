<Project Sdk="Microsoft.NET.Sdk">
  <!-- digitizer_check: touchscreens, pens and touchpads. spike <backend>:
       a two-finger touchscreen and a pen as custom profiles, no contacts,
       and what Windows builds for them: the HID children and their IDs,
       the feature reads and writes it sends, and session 0's digitizer
       metrics. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DigitizerCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Another running program with HIDMaestro.Core.dll loaded. -->
    <Compile Include="..\probe_common\SdkConsumers.cs" Link="SdkConsumers.cs" />
  </ItemGroup>
</Project>
