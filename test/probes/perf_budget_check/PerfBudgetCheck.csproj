<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PerfBudgetCheck</AssemblyName>
    <!-- A build with its own BaseIntermediateOutputPath (HmSdkDll below)
         stops excluding obj\, so the generated sources of every build's
         intermediate folder stay out of the compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj-*\**</DefaultItemExcludes>
    <!-- -p:HmBase=true builds against a b4d29d9 tree for the "before"
         measurements, leaving out what b4d29d9 lacks. -->
    <DefineConstants Condition="'$(HmBase)' == 'true'">$(DefineConstants);HM_BASE</DefineConstants>
    <!-- b4d29d9 grants its internals to a fixed list of probe names
         (Internal\AssemblyInfo.cs there), PerfBudgetCheck not among them,
         so the build against it takes one of the names it lists. -->
    <AssemblyName Condition="'$(HmBase)' == 'true'">OutputPerfBench</AssemblyName>
    <!-- -p:HmDd4Base=true builds against the tree before lane DD-4 for
         ProgramCost's "before" measurements. A property of this project
         only, where -p:DefineConstants would reach the SDK's build too. -->
    <DefineConstants Condition="'$(HmDd4Base)' == 'true'">$(DefineConstants);DD4_BASE</DefineConstants>
    <!-- -p:HmBaselineTree=<checkout> builds this source against the SDK of
         another checkout, for the "before" measurements of the v2.0.0
         conversion: a worktree whose SDK, drivers and profiles are
         $(HmBaselineCommit)'s (lane/B0 at 9bd6279). The probe then runs
         that SDK, which embeds that checkout's build\ and so deploys its
         driver. Code for what the baseline lacks goes under
         #if !HM_BASELINE. CheckBaselineTree refuses a checkout whose
         sources differ from the commit, committed or not. -->
    <HmBaselineCommit Condition="'$(HmBaselineCommit)' == ''">9bd6279</HmBaselineCommit>
    <DefineConstants Condition="'$(HmBaselineTree)' != ''">$(DefineConstants);HM_BASELINE</DefineConstants>
    <!-- The same for a build against an SDK assembly (HmBaseSdkDll below):
         Ds3Cost then takes the frame code it carries for an older tree. -->
    <DefineConstants Condition="'$(HmBaseSdkDll)' != ''">$(DefineConstants);HM_BASELINE</DefineConstants>
    <_HmSdkProject Condition="'$(HmBaselineTree)' == ''">..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj</_HmSdkProject>
    <_HmSdkProject Condition="'$(HmBaselineTree)' != ''">$([MSBuild]::EnsureTrailingSlash('$(HmBaselineTree)'))sdk\HIDMaestro.Core\HIDMaestro.Core.csproj</_HmSdkProject>
  </PropertyGroup>
  <!-- -p:HmBaseSdkDll=<path> with -p:HmBase=true compiles against an SDK
       assembly a b4d29d9 build already made (its HIDMaestro.Core.dll, which
       embeds that build's driver) instead of a b4d29d9 tree, so the before
       probe runs the very SDK and driver of the earlier measurements. -->
  <!-- -p:HmSdkDll=<path> compiles this source as it is against the SDK
       assembly another 2.x tree built (its HIDMaestro.Core.dll, which embeds
       that tree's driver), with none of the HM_BASE or HM_BASELINE
       exclusions: the base side of a release A/B, such as v2.0.3's build,
       when this source carries modes or rows that tree's probe lacks. Give
       it its own -o and -p:BaseIntermediateOutputPath, so it never shares
       an output with this tree's own build. -->
  <ItemGroup Condition="'$(HmBaseSdkDll)' == '' and '$(HmSdkDll)' == ''">
    <ProjectReference Include="$(_HmSdkProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(HmBaseSdkDll)' != ''">
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HmBaseSdkDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HmSdkDll)' != ''">
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HmSdkDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckSdkDll" BeforeTargets="ResolveAssemblyReferences;BeforeBuild" Condition="'$(HmSdkDll)' != ''">
    <Error Condition="!Exists('$(HmSdkDll)')" Text="HmSdkDll: no SDK assembly at $(HmSdkDll)." />
    <Error Condition="'$(HmBaseSdkDll)' != '' or '$(HmBaselineTree)' != '' or '$(HmBase)' == 'true'" Text="HmSdkDll builds against a 2.x SDK as is. It does not combine with HmBase, HmBaseSdkDll or HmBaselineTree." />
  </Target>
  <!-- The program-file mode measures a profile file's programs on the
       interpreter with the profile check tool's own code, which only a
       tree with report programs builds. -->
  <ItemGroup Condition="'$(HmBaselineTree)' == '' and '$(HmBase)' != 'true' and '$(HmDd4Base)' != 'true'">
    <Compile Include="..\..\..\tools\HIDMaestroProfileCheck\InterpreterCost.cs" Link="InterpreterCost.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(HmBaselineTree)' == '' and '$(HmBase)' != 'true' and '$(HmDd4Base)' != 'true'">
    <DefineConstants>$(DefineConstants);HM_PROGRAM_FILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HmBaselineTree)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HmBaselineTree</_Parameter1>
      <_Parameter2>$(HmBaselineTree)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HmBaselineCommit</_Parameter1>
      <_Parameter2>$(HmBaselineCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The baseline checkout's SDK, drivers and profiles must be the
       commit's, both at HEAD and in the working tree. -->
  <Target Name="CheckBaselineTree" BeforeTargets="ResolveProjectReferences;BeforeBuild" Condition="'$(HmBaselineTree)' != ''">
    <Error Condition="!Exists('$(_HmSdkProject)')" Text="HmBaselineTree: no SDK project at $(_HmSdkProject)." />
    <Exec Command="git -C &quot;$(HmBaselineTree)&quot; diff --quiet $(HmBaselineCommit) -- sdk driver profiles" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_HmBaselineDiff" />
    </Exec>
    <Error Condition="'$(_HmBaselineDiff)' != '0'" Text="HmBaselineTree: the SDK, drivers or profiles in $(HmBaselineTree) differ from $(HmBaselineCommit) (git diff exit $(_HmBaselineDiff))." />
    <!-- git diff does not see a file git does not track, which the build
         would still compile or embed. -->
    <Exec Command="git -C &quot;$(HmBaselineTree)&quot; status --porcelain --untracked-files=all -- sdk driver profiles" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_HmBaselineUntracked" />
    </Exec>
    <Error Condition="'$(_HmBaselineUntracked)' != ''" Text="HmBaselineTree: $(HmBaselineTree) holds files under sdk, driver or profiles that $(HmBaselineCommit) does not: $(_HmBaselineUntracked)" />
  </Target>

  <!-- ds3cost's native half: 9bd6279's DualShock 3 and Switch Pro frame code
       and this tree's frame, built by native\build.ps1 into the output. -->
  <Target Name="BuildNativeFrames" AfterTargets="Build" Condition="'$(SkipNativeFrames)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\native\build.ps1&quot; -Out &quot;$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)')).&quot;" />
  </Target>
</Project>
