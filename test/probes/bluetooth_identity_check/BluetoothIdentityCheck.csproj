<Project Sdk="Microsoft.NET.Sdk">
  <!-- bluetooth_identity_check: a Bluetooth profile presents its own form
       on every backend, and a program reads it on the Bluetooth bus.
       offline: what each Bluetooth profile presents, its USB device and the
       marker of its transport. live <backend>: the bus hidapi reads, and
       each HID collection's version, product string and reports.
       sdl <backend> <dir>: what SDL opens, through the SDL3.dll in <dir>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BluetoothIdentityCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
</Project>
