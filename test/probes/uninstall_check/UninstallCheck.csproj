<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>UninstallCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
    <!-- The tool itself, built with its NativeAOT publishes. Its
         assembly is not referenced: the probe runs the published tool. -->
    <ProjectReference Include="..\..\..\tools\HIDMaestroUninstall\HIDMaestroUninstall.csproj"
                      ReferenceOutputAssembly="false" Condition="'$(HMSandboxPublish)' != 'true'" />
  </ItemGroup>

  <!-- The tool's NativeAOT build for this machine's architecture goes into
       tool\ beside the probe. NativeAOT needs no .NET runtime, so the same
       copy runs inside Windows Sandbox. -->
  <Target Name="CopyUninstallTool" AfterTargets="Build" Condition="'$(HMSandboxPublish)' != 'true'">
    <ItemGroup>
      <_HMUninstallTool Include="$(MSBuildProjectDirectory)\..\..\..\tools\HIDMaestroUninstall\bin\$(Configuration)\$(TargetFramework)\aot-$(HMTargetArchitecture)\HIDMaestroUninstall.exe" />
    </ItemGroup>
    <Error Condition="!Exists('@(_HMUninstallTool)')" Text="The tool's NativeAOT build is missing: @(_HMUninstallTool)" />
    <Copy SourceFiles="@(_HMUninstallTool)" DestinationFolder="$(OutDir)tool" SkipUnchangedFiles="true" />
  </Target>

  <!-- Windows Sandbox has no .NET runtime, so the copy of the probe that runs
       inside it is published self-contained into sandbox\ beside the probe,
       as usbip_install_check does. -->
  <Target Name="PublishForSandbox" AfterTargets="Build" Condition="'$(HMSandboxPublish)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:HMSandboxPublish=true -o &quot;$(OutDir)sandbox&quot; --nologo -v:quiet" />
  </Target>
</Project>
