<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AotSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>

  <!-- The four apps the battery runs: NativeAOT, and trimmed self-contained
       single-file, for x64 and ARM64, each published beside the probe. Each
       publish gets its own intermediate directory under obj\, and passes
       HMSmokePublish so it does not publish again. -->
  <ItemGroup Condition="'$(HMSmokePublish)' != 'true'">
    <HMSmokeApp Include="aot-x64" Rid="win-x64" Args="-p:PublishAot=true" />
    <HMSmokeApp Include="trim-x64" Rid="win-x64" Args="--self-contained true -p:PublishTrimmed=true -p:PublishSingleFile=true" />
    <HMSmokeApp Include="aot-arm64" Rid="win-arm64" Args="-p:PublishAot=true" />
    <HMSmokeApp Include="trim-arm64" Rid="win-arm64" Args="--self-contained true -p:PublishTrimmed=true -p:PublishSingleFile=true" />
  </ItemGroup>

  <!-- NativeAOT finds the linker through vcvarsall.bat, which runs
       vswhere.exe from PATH. On a machine whose PATH lacks the Visual Studio
       Installer folder, the error text lands where the linker's path should
       be and the link fails, so these publishes get the folder on PATH. The
       value is escaped because EnvironmentVariables splits on semicolons. -->
  <PropertyGroup>
    <_HMSmokePath>$([MSBuild]::Escape('$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer;$(PATH)'))</_HMSmokePath>
  </PropertyGroup>
  <!-- The publish runs at -v:quiet, which still prints warnings. Its output
       comes back through ConsoleToMSBuild and the build fails when any line
       carries an IL warning or error code: the trim analyzers (IL2xxx), the
       NativeAOT and single-file analyzers (IL3xxx) and the linker and
       compiler passes. The SDK's own build turns the same codes into errors
       (aot-analyzers.globalconfig), so a warning here comes from the app, a
       reference the SDK does not analyze, or a publish step. -->
  <Target Name="PublishSmokeApps" AfterTargets="Build" Condition="'$(HMSmokePublish)' != 'true'">
    <Exec EnvironmentVariables="PATH=$(_HMSmokePath)" ConsoleToMSBuild="true" Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r %(HMSmokeApp.Rid) %(HMSmokeApp.Args) -p:HMSmokePublish=true -p:IntermediateOutputPath=obj\$(Configuration)\%(HMSmokeApp.Identity)\ -o &quot;$(OutDir)%(HMSmokeApp.Identity)&quot; --nologo -v:quiet">
      <Output TaskParameter="ConsoleOutput" ItemName="_HMSmokeOutput" />
    </Exec>
    <ItemGroup>
      <_HMSmokeIlWarning Include="@(_HMSmokeOutput)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(warning|error) IL\d{4}:'))" />
    </ItemGroup>
    <Error Condition="'@(_HMSmokeIlWarning)' != ''" Text="The smoke publish reported trimming, single-file or NativeAOT warnings: @(_HMSmokeIlWarning, ' | ')" />
  </Target>
</Project>
