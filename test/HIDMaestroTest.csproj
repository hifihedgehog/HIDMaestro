<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-$(HMTargetArchitecture)</RuntimeIdentifier>
    <PlatformTarget>$(HMTargetArchitecture)</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj" />
  </ItemGroup>
  <!-- Diagnostic probes live in test/probes/ as independent standalone projects
       (each has its own .csproj). The SDK's default **/*.cs glob would
       otherwise pull their Program.cs files into this test app's compile
       and collide on class P / Main(). Keep them excluded here; build each
       probe via its own csproj or build_*.cmd. See test/probes/README.md. -->
  <ItemGroup>
    <Compile Remove="probes\**\*.cs" />
    <None Remove="probes\**\*" />
    <Compile Remove="sandbox\**\*.cs" />
    <None Remove="sandbox\**\*" />
    <!-- Source the battery compiles with Add-Type, not part of the test app. -->
    <Compile Remove="regression\**\*.cs" />
  </ItemGroup>
  <!-- The record option of probe-xusb writes device_oracle_check's golden
       format. Listed after the removal above, which drops every file under
       probes\. -->
  <ItemGroup>
    <Compile Include="probes\device_oracle_check\Golden.cs" Link="Golden.cs" />
    <Compile Include="probes\device_oracle_check\LiveRecorder.cs" Link="LiveRecorder.cs" />
  </ItemGroup>
</Project>
