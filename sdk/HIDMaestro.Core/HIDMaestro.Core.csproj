<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- AnyCPU on purpose. The assembly carries a driver payload for
         each architecture and picks at extraction time, so one DLL
         runs on x64 and ARM64 Windows alike. Pinning a platform here
         would make the ARM64 half unreachable. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Usable from NativeAOT, trimmed and single-file apps. This marks the
         assembly trimmable and turns on the trim, single-file and AOT
         analyzers. aot-analyzers.globalconfig makes any of their warnings an
         error in Release, so a change that breaks one of those app kinds
         fails the build instead of the consumer. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Library identity -->
    <AssemblyName>HIDMaestro.Core</AssemblyName>
    <RootNamespace>HIDMaestro</RootNamespace>
    <Description>HIDMaestro UMDF2 virtual HID controller engine: embed in your app to create exact-fidelity virtual game controllers.</Description>

    <!-- Pack everything (driver DLLs, INFs, signing/catalog tools, profile JSONs)
         inside the assembly as embedded resources so single-file publishing in
         the consuming app picks them up automatically: no sibling files, no
         WDK install required on the user's machine. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Source paths used by the PackResources pre-build target. -->
    <HMRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</HMRepoRoot>
    <HMBuildDir>$(HMRepoRoot)build\</HMBuildDir>
    <HMWdkBin>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\</HMWdkBin>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <GlobalAnalyzerConfigFiles Include="aot-analyzers.globalconfig" />
  </ItemGroup>

  <!-- Pre-build: refresh embedded payload from build/ and the local WDK install.
       This runs once per `dotnet build` so the embedded resources always reflect
       the latest driver binaries. The Resources/ directory is .gitignored. -->
  <Target Name="PackResources" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildThisFileDirectory)Resources" />

    <ItemGroup>
      <!-- Driver binaries + INFs from build/ -->
      <_HMDriverName Include="HIDMaestro.dll" />
      <_HMDriverName Include="HMXInput.dll" />
      <_HMDriverName Include="hidmaestro.inf" />
      <_HMDriverName Include="hidmaestro_xusb.inf" />
      <!-- hmswd.exe: SWD device creation helper, shelled out to by
           SwdDeviceFactory for the ROOT\ → SWD\ migration (slot-1-skip fix).
           Embedded here so single-file deployment still has it. -->
      <_HMDriverName Include="hmswd.exe" />

      <!-- OpenVR driver package (issue #32): the entire SteamVR driver
           folder from build\openvr\hidmaestro, embedded with its layout
           preserved so VrDriverBuilder can reconstruct it verbatim. Built
           by scripts\build_openvr.cmd; absent on a fresh clone until the
           native phase has run, same contract as the driver binaries. -->
      <_HMVrFiles Include="$(HMBuildDir)openvr\hidmaestro\**\*"
                  Exclude="$(HMBuildDir)openvr\hidmaestro\**\*.lib;$(HMBuildDir)openvr\hidmaestro\**\*.exp;$(HMBuildDir)openvr\hidmaestro\**\*.pdb" />

      <!-- signtool.exe + its SXS dep tree (from WDK x64) -->
      <_HMSignName Include="signtool.exe" />
      <_HMSignName Include="signtool.exe.manifest" />
      <_HMSignName Include="mssign32.dll" />
      <_HMSignName Include="Microsoft.Windows.Build.Signing.mssign32.dll.manifest" />
      <_HMSignName Include="wintrust.dll" />
      <_HMSignName Include="wintrust.dll.ini" />
      <_HMSignName Include="Microsoft.Windows.Build.Signing.wintrust.dll.manifest" />
      <_HMSignName Include="appxsip.dll" />
      <_HMSignName Include="Microsoft.Windows.Build.Appx.AppxSip.dll.manifest" />
      <_HMSignName Include="appxpackaging.dll" />
      <_HMSignName Include="Microsoft.Windows.Build.Appx.AppxPackaging.dll.manifest" />
      <_HMSignName Include="opcservices.dll" />
      <_HMSignName Include="Microsoft.Windows.Build.Appx.OpcServices.dll.manifest" />

      <!-- inf2cat.exe + its minimum dep set (from WDK x86).
           apivalidator.exe / microsoft.kits.drivers.apivalidator.dll /
           Microsoft.Extensions.CommandLineUtils.dll were tested and are NOT
           required for /os:10_X64 catalog generation. -->
      <_HMInf2cat Include="$(HMWdkBin)x86\Inf2Cat.exe" />
      <_HMInf2cat Include="$(HMWdkBin)x86\inf2cat.exe.manifest" />
      <_HMInf2cat Include="$(HMWdkBin)x86\WindowsProtectedFiles.xml" />
      <_HMInf2cat Include="$(HMWdkBin)x86\Microsoft.UniversalStore.HardwareWorkflow.Cabinets.dll" />
      <_HMInf2cat Include="$(HMWdkBin)x86\Microsoft.UniversalStore.HardwareWorkflow.Catalogs.dll" />
      <_HMInf2cat Include="$(HMWdkBin)x86\Microsoft.UniversalStore.HardwareWorkflow.InfReader.dll" />
      <_HMInf2cat Include="$(HMWdkBin)x86\Microsoft.UniversalStore.HardwareWorkflow.SubmissionBuilder.dll" />
      <_HMInf2cat Include="$(HMWdkBin)x86\Microsoft.Kits.Logger.dll" />
      <!-- One payload set per target architecture. Driver, XUSB
           companion, SWD helper, both stamped INFs and the signing
           tool tree all differ by architecture, and the machine that
           installs them is the one that runs them. -->
      <_HMX64File Include="@(_HMDriverName-&gt;'$(HMBuildDir)%(Identity)');@(_HMSignName-&gt;'$(HMWdkBin)x64\%(Identity)')" />
      <_HMArm64File Include="@(_HMDriverName-&gt;'$(HMBuildDir)arm64\%(Identity)');@(_HMSignName-&gt;'$(HMWdkBin)arm64\%(Identity)')" />
    </ItemGroup>

    <Error Condition="!Exists('$(HMBuildDir)HIDMaestro.dll')"
           Text="No x64 driver in $(HMBuildDir). Run scripts\build_all.cmd, which builds both architectures before this project." />
    <Error Condition="!Exists('$(HMBuildDir)arm64\HIDMaestro.dll')"
           Text="No ARM64 driver in $(HMBuildDir)arm64\. Run scripts\build_all.cmd, which builds both architectures before this project." />

    <Copy SourceFiles="@(_HMX64File)" DestinationFolder="$(MSBuildThisFileDirectory)Resources\x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_HMArm64File)" DestinationFolder="$(MSBuildThisFileDirectory)Resources\arm64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_HMVrFiles)" DestinationFiles="@(_HMVrFiles->'$(MSBuildThisFileDirectory)Resources\vr\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_HMVrFiles)' != ''" />
    <Copy SourceFiles="@(_HMInf2cat)"    DestinationFolder="$(MSBuildThisFileDirectory)Resources\" SkipUnchangedFiles="true" />

    <!-- usbip-win2 0.9.8.1 installer, bundled (issue #39). Composite USB
         personas need a driver-backed USB device for their audio
         endpoints, so the SDK ships the transport rather than asking a
         user to go install one: HIDMaestro deploys it on demand, the
         same way it deploys its own UMDF2 driver. BSD-2-Clause permits
         binary redistribution; the required notice ships beside it as
         THIRD-PARTY-NOTICES.txt and is written to disk at install time.

         The binaries are NOT committed. Each is fetched once and cached
         in Resources/ (gitignored), then checked against its pinned
         SHA-256. A hash mismatch FAILS the build rather than embedding an
         unverified binary. -->
    <PropertyGroup>
      <HMUsbipVersion>0.9.8.1</HMUsbipVersion>
      <HMUsbipAsset>USBip-$(HMUsbipVersion)-x64.exe</HMUsbipAsset>
      <HMUsbipSha256>38cad6d4432b52d5bb9409d9ad03b72fdffc4ada4cd3a48fbeca1a2752a8518a</HMUsbipSha256>
      <HMUsbipFile>$(MSBuildThisFileDirectory)Resources\$(HMUsbipAsset)</HMUsbipFile>
      <HMUsbipUrl>https://github.com/vadimgrn/usbip-win2/releases/download/v.$(HMUsbipVersion)/$(HMUsbipAsset)</HMUsbipUrl>
      <HMUsbipArmAsset>USBip-$(HMUsbipVersion)-arm64-release-attestation.exe</HMUsbipArmAsset>
      <HMUsbipArmSha256>cab7ff97f79275eeb5c5b8bb2eb3111ff6b6c4eead07d9bec9be5bd1e3a35800</HMUsbipArmSha256>
      <HMUsbipArmFile>$(MSBuildThisFileDirectory)Resources\$(HMUsbipArmAsset)</HMUsbipArmFile>
      <HMUsbipArmUrl>https://static.ossign.org/signed/usbip-win2/$(HMUsbipArmAsset)</HMUsbipArmUrl>
    </PropertyGroup>

    <DownloadFile SourceUrl="$(HMUsbipUrl)"
                  DestinationFolder="$(MSBuildThisFileDirectory)Resources"
                  DestinationFileName="$(HMUsbipAsset)"
                  SkipUnchangedFiles="true"
                  Condition="!Exists('$(HMUsbipFile)')" />

    <GetFileHash Files="$(HMUsbipFile)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_HMUsbipActualHash" />
    </GetFileHash>
    <Error Condition="'$(_HMUsbipActualHash.ToLowerInvariant())' != '$(HMUsbipSha256)'"
           Text="usbip-win2 installer hash mismatch. Expected $(HMUsbipSha256), got $(_HMUsbipActualHash). Delete $(HMUsbipFile) and rebuild to re-fetch." />

    <!-- ARM64 transport. The 0.9.8.1 release page carries the x64
         installer only. This is the ARM64 build of the same tag that the
         project's signer posted in usbip-win2 issue #13, with drivers
         attestation-signed by Microsoft. -->
    <DownloadFile SourceUrl="$(HMUsbipArmUrl)"
                  DestinationFolder="$(MSBuildThisFileDirectory)Resources"
                  DestinationFileName="$(HMUsbipArmAsset)"
                  SkipUnchangedFiles="true"
                  Condition="!Exists('$(HMUsbipArmFile)')" />

    <GetFileHash Files="$(HMUsbipArmFile)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_HMUsbipArmActualHash" />
    </GetFileHash>
    <Error Condition="'$(_HMUsbipArmActualHash.ToLowerInvariant())' != '$(HMUsbipArmSha256)'"
           Text="usbip-win2 ARM64 installer hash mismatch. Expected $(HMUsbipArmSha256), got $(_HMUsbipArmActualHash). Delete $(HMUsbipArmFile) and rebuild to re-fetch." />

    <!-- The host controller's own INF/SYS/CAT, unpacked from the verified
         installers above and checked file by file against
         UsbipPackage.json. The SDK uses them to move a machine off the
         transport an earlier release installed through PnP, which the
         installer cannot do without launching the old version's
         uninstaller. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(HMRepoRoot)scripts\prepare_usbip.ps1&quot; -InstallerDirectory &quot;$(MSBuildThisFileDirectory)Resources&quot; -DestinationDirectory &quot;$(MSBuildThisFileDirectory)Resources\usbip&quot;" />

    <Copy SourceFiles="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt"
          DestinationFolder="$(MSBuildThisFileDirectory)Resources\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Driver/tool payload. Embedded with stable HIDMaestro.Resources.* logical
         names so DriverBuilder can extract them by name at install time.
         CAUTION: this glob is evaluated at MSBuild item-evaluation time,
         BEFORE the PackResources target above runs. If Resources/ is empty
         or missing (fresh clone, post-`rm -rf bin obj Resources`), the glob
         emits zero items and the assembly compiles with NO driver embedded
         (observed: 276 KB instead of 6.8 MB) → DriverBuilder.EnsureExtracted
         throws at runtime. And when Resources/ has STALE bytes from a prior
         build, they get silently embedded before the current PackResources
         overwrites them. The canonical fix is `scripts/build_all.cmd`:
         first build driver + companion for both architectures, then run
         `dotnet build` ONCE to populate Resources/ (which will emit a
         warning-size DLL), then run `dotnet build` AGAIN to embed the
         fresh bytes. The release recipe does this two-phase build.

         This glob is flat on purpose. It takes the architecture-neutral
         payload only, and the two globs below take the per-architecture
         sets out of Resources\x64 and Resources\arm64. -->
    <EmbeddedResource Include="Resources\*">
      <LogicalName>HIDMaestro.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Architecture-specific payload. DriverBuilder picks the
         namespace matching the OS it runs on, so one AnyCPU assembly
         serves both x64 and ARM64 Windows. -->
    <EmbeddedResource Include="Resources\x64\*">
      <LogicalName>HIDMaestro.Native.x64.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\arm64\*">
      <LogicalName>HIDMaestro.Native.arm64.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- usbip-win2 host controller driver files, per architecture. -->
    <EmbeddedResource Include="Resources\usbip\x64\*">
      <LogicalName>HIDMaestro.Usbip.x64.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\usbip\arm64\*">
      <LogicalName>HIDMaestro.Usbip.arm64.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- OpenVR driver package (issue #32). Nested logical names preserve
         the SteamVR driver-folder layout (bin/win64/..., resources/...)
         so extraction is a verbatim reconstruction; the flat
         HIDMaestro.Resources.* namespace stays collision-free. -->
    <EmbeddedResource Include="Resources\vr\**\*">
      <LogicalName>HIDMaestro.VR.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Profile catalog. Embedded with stable HIDMaestro.Profiles.* logical
         names so HMContext.LoadDefaultProfiles() can read them via
         Assembly.GetManifestResourceStream regardless of disk layout. The
         repo's profiles/ directory is the single source of truth. These
         are linked, not copied.

         The composite USB personas (dualsense-composite,
         dualshock-4-v2-composite) ship in the catalog as of the USB/IP
         backend landing (issue #39): CreateController instantiates them
         when usbip-win2 is installed and refuses with install guidance
         when it is not. Consumers gate picker entries on
         HMProfile.RequiresUsbipBackend + HMContext.IsUsbipBackendAvailable. -->
    <EmbeddedResource Include="..\..\profiles\**\*.json"
                      Exclude="..\..\profiles\schema.json;..\..\profiles\scraped_descriptors.json;..\..\profiles\linux-kernel-fixed-descriptors.json">
      <LogicalName>HIDMaestro.Profiles.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <Link>Profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
