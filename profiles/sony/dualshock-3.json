ck holds, and their buttons, 8 and 9, are set while their byte is above zero. buttonMap puts every HMButton bit on the same button in a report built from the descriptor.","layout":{"kind":"gamepad","source":"https://en.wikipedia.org/wiki/DualShock#DualShock_3","sticks":[{"side":"left","xAxis":"X","yAxis":"Y","clickButton":1},{"side":"right","xAxis":"Z","yAxis":"Rz","clickButton":2}],"triggers":[],"dpad":{"encoding":"buttons","upButton":4,"downButton":6,"leftButton":7,"rightButton":5},"faceButtons":[{"role":"face_x","buttonIndex":15},{"role":"face_a","buttonIndex":14},{"role":"face_b","buttonIndex":13},{"role":"face_y","buttonIndex":12}],"systemButtons":[{"role":"back","buttonIndex":0},{"role":"start","buttonIndex":3},{"role":"ps","buttonIndex":16}],"shoulderButtons":[{"role":"left_bumper","buttonIndex":10},{"role":"right_bumper","buttonIndex":11},{"role":"left_trigger_click","buttonIndex":8},{"role":"right_trigger_click","buttonIndex":9}],"haptics":{"rumble":"dual_erm","triggerHaptics":false},"imu":{"accelerometer":true,"gyroscope":true,"magnetometer":false}}}
