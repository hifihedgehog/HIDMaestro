/* Shared VERSIONINFO body for every native binary HIDMaestro ships.
 *
 * Why this exists: the driver DLL, its companion, and hmswd.exe were all
 * built with NO version resource at all. A native x64 binary that carries
 * no CompanyName, ProductName or FileDescription, is unsigned on disk,
 * and has near-zero install prevalence is close to a worked example of
 * what an antivirus machine-learning classifier is trained to distrust.
 * Microsoft Defender flagged HIDMaestro.dll as Trojan:Win32/Bearfoos.A!ml
 * on 2026-09-02 for exactly that shape. The "!ml" suffix marks a
 * machine-learning verdict rather than a signature match, so the durable
 * answer is to stop looking anonymous, not only to get one hash cleared:
 * a whitelist entry covers a single hash, and every rebuild mints a new
 * one.
 *
 * Each binary includes this file after defining its own HM_DESC and
 * HM_ORIGINAL, which keeps the shared fields in one place and avoids
 * passing quoted strings through rc.exe on a batch command line.
 * HM_VER_* come from build/version_gen.h, generated by
 * scripts/gen_version.ps1 from Directory.Build.props, so the resource
 * cannot drift from the released version.
 */

#include <winver.h>
#include "version_gen.h"

#ifndef HM_DESC
#define HM_DESC "HIDMaestro"
#endif
#ifndef HM_ORIGINAL
#define HM_ORIGINAL "HIDMaestro.dll"
#endif

/* Drivers declare VFT_DRV. verrsrc.h has no input-device subtype (the
   VFT2_DRV_* list stops at VERSIONED_PRINTER), so a HID minidriver takes
   VFT2_DRV_SYSTEM. hmswd.exe overrides both to VFT_APP, because metadata
   that misdescribes the binary is its own small red flag. */
#ifndef HM_FILETYPE
#define HM_FILETYPE    VFT_DRV
#define HM_FILESUBTYPE VFT2_DRV_SYSTEM
#endif
#ifndef HM_FILESUBTYPE
#define HM_FILESUBTYPE VFT2_UNKNOWN
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    HM_VER_MAJOR,HM_VER_MINOR,HM_VER_PATCH,0
 PRODUCTVERSION HM_VER_MAJOR,HM_VER_MINOR,HM_VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       HM_FILETYPE
 FILESUBTYPE    HM_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HIDMaestro"
            VALUE "FileDescription",  HM_DESC
            VALUE "FileVersion",      HM_VER_STRING
            VALUE "InternalName",     HM_ORIGINAL
            VALUE "OriginalFilename", HM_ORIGINAL
            VALUE "ProductName",      "HIDMaestro"
            VALUE "ProductVersion",   HM_VER_STRING
            VALUE "LegalCopyright",   "Copyright (c) 2026 HIDMaestro Contributors. MIT licensed."
            VALUE "Comments",         "Open source, MIT licensed. https://github.com/hifihedgehog/HIDMaestro"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
